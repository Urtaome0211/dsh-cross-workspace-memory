{
  "name": "dsh-cross-workspace-memory",
  "version": "0.1.2",
  "description": "Cross-workspace long-term memory for DeepSeek Harness: one machine-local store shared by every workspace, a compact index injected at session start, and a searchable tool for the details.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "cross-workspace",
    "recall"
  ],
  "license": "MIT",
  "author": "Urtaome0211 (https://github.com/Urtaome0211)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Urtaome0211/dsh-cross-workspace-memory.git"
  },
  "homepage": "https://github.com/Urtaome0211/dsh-cross-workspace-memory#readme",
  "bugs": {
    "url": "https://github.com/Urtaome0211/dsh-cross-workspace-memory/issues"
  },
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "lib",
    "tools",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./store": "./lib/store.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/store.test.mjs",
    "probe": "node tools/session-stats.mjs"
  }
}
